---
/**
 * Responsive YouTube embed.
 *
 * Renders a 16:9 player from the privacy-enhanced youtube-nocookie.com domain
 * (already allowed by the Content-Security-Policy in public/_headers). The
 * iframe is lazy-loaded, so YouTube's player script is not fetched until the
 * video scrolls near the viewport.
 *
 * Set the thumbnail shown before play in YouTube Studio for the video.
 */
interface Props {
  /** The YouTube video ID, e.g. "I05qzUQyjvg" from youtu.be/I05qzUQyjvg */
  videoId: string;
  /** Accessible title for the player */
  title: string;
  class?: string;
}

const { videoId, title, class: className = "" } = Astro.props;
---

<div class:list={["yt-embed", className]}>
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${videoId}?rel=0`}
    title={title}
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
  ></iframe>
</div>

<style>
  .yt-embed {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #1a1a1a;
  }

  .yt-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    border: 0;
  }
</style>
